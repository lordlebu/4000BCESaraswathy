{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "g=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}/.claude/hooks/push-gate.sh\"; [ -x \"$g\" ] && \"$g\" || exit 0",
            "timeout": 30,
            "statusMessage": "Checking the branch has not already merged"
          }
        ]
      }
    ]
  }
}
